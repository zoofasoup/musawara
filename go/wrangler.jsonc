{
  // go.musawara.id: small public mini apps. Static pages from ./public, plus a few read-only API routes in worker.ts.
  // Deploy with: npx wrangler deploy -c go/wrangler.jsonc
  "name": "musawara-go",
  "main": "worker.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "go.musawara.id", "custom_domain": true }],
  "observability": { "enabled": true }
}
