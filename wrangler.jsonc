{
  // musawara.id — Worker aset statis.
  //
  // Belum ada "main": selama situs ini murni statis, permintaan dilayani
  // langsung dari ./public tanpa menjalankan kode Worker sama sekali, jadi
  // tidak terhitung sebagai invokasi dan tidak menambah biaya.
  //
  // Saat nanti butuh /api/*, tambahkan:
  //   "main": "worker/index.ts",
  //   "assets": { ..., "binding": "ASSETS", "run_worker_first": ["/api/*"] }
  "name": "musawara-web",
  "compatibility_date": "2026-08-01",

  "assets": {
    "directory": "./public",
    // "auto-trailing-slash" membuat /nuralive/kalkulator dilayani dari
    // /nuralive/kalkulator/index.html tanpa perlu menulis .html di URL.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },

  "observability": { "enabled": true }
}
