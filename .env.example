# Supabase — Project Settings → API
# The anon key is safe to expose: every public table is protected by RLS
# policies that only expose rows where is_published = true.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Resend — careers application notifications.
# If RESEND_API_KEY is unset the form still saves to the database and the
# submission is logged to the server console instead of emailed.
RESEND_API_KEY=
CAREERS_NOTIFY_FROM=careers@musawara.co.id
CAREERS_NOTIFY_TO=ahmadzufaaar@gmail.com

# Public site origin, used for canonical URLs and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
