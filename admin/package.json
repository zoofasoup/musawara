{
  "name": "musawara-ads",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc --noEmit",
    "start": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply musawara-ads --local",
    "db:migrate:remote": "wrangler d1 migrations apply musawara-ads --remote",
    "db:seed:local": "node scripts/generate-seed.mjs .seed.sql && wrangler d1 execute musawara-ads --local --file=.seed.sql"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "read-excel-file": "^9.3.14",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250620.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "wrangler": "^4.86.0"
  }
}
