{
  "name": "musawara-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:admin",
    "build:admin": "npm run build --prefix admin && rm -rf out/admin && cp -R admin/dist out/admin",
    "start": "next start",
    "lint": "eslint",
    "check": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json && npm run check --prefix admin",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "marked": "^15.0.7",
    "next": "16.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "2.18.2",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "2.16.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.164.0"
  }
}
